{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Brand AI-Readiness Audit Report",
  "type": "object",
  "required": ["site", "audited_at", "summary", "findings"],
  "additionalProperties": true,
  "properties": {
    "site": { "type": "string", "minLength": 1 },
    "audited_at": { "type": "string", "minLength": 1 },
    "audit_meta": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "pages_crawled": { "type": "integer", "minimum": 0 },
        "render_mode": { "type": "string", "enum": ["headless", "static-only"] },
        "robots_respected": { "type": "boolean" },
        "site_type": { "type": "string" },
        "skills_run": { "type": "array", "items": { "type": "string" } },
        "runtime_seconds": { "type": "number", "minimum": 0 }
      }
    },
    "summary": {
      "type": "object",
      "required": ["total_findings", "critical", "high", "medium"],
      "additionalProperties": true,
      "properties": {
        "total_findings": { "type": "integer", "minimum": 0 },
        "critical": { "type": "integer", "minimum": 0 },
        "high": { "type": "integer", "minimum": 0 },
        "medium": { "type": "integer", "minimum": 0 },
        "low": { "type": "integer", "minimum": 0 }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "check_id", "title", "severity", "category",
                     "mechanism", "evidence", "suggested_action"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "pattern": "^F-[0-9]{3,}$" },
          "check_id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "category": {
            "type": "string",
            "enum": ["discoverability", "engagement"]
          },
          "mechanism": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 },
          "affected_urls": { "type": "array", "items": { "type": "string" } },
          "prevalence": {
            "type": "object",
            "properties": {
              "affected": { "type": "integer", "minimum": 0 },
              "sampled": { "type": "integer", "minimum": 0 }
            }
          },
          "suggested_action": {
            "type": "object",
            "required": ["summary", "priority"],
            "additionalProperties": true,
            "properties": {
              "summary": { "type": "string", "minLength": 1 },
              "priority": {
                "type": "string",
                "enum": ["critical", "high", "medium", "low"]
              },
              "effort": {
                "type": "string",
                "enum": ["low", "medium", "high"]
              },
              "steps": { "type": "array", "items": { "type": "string" } },
              "example": { "type": "string" },
              "expected_impact": { "type": "string" },
              "verification": { "type": "string" }
            }
          }
        }
      }
    },
    "proactive_recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "rationale", "priority"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "rationale": { "type": "string" },
          "priority": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "effort": { "type": "string", "enum": ["low", "medium", "high"] },
          "steps": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "not_applicable": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check_id", "reason"],
        "properties": {
          "check_id": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "inconclusive": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check_id", "reason"],
        "properties": {
          "check_id": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
